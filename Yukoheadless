-- ====== KORBLOX LOGIC ======
-- Tracks per-side state so we can cleanly disable/restore later
local korbloxEnabled = { Left = false, Right = false }
local korbloxSwapData = { Left = {}, Right = {} } -- list of {oldPart, motor, clonedPart}

local function disableKorbloxLeg(side)
    local character = player.Character
    local swaps = korbloxSwapData[side]

    for _, swap in ipairs(swaps) do
        if swap.clonedPart then
            swap.clonedPart:Destroy()
        end
        if swap.motor then
            swap.motor.Enabled = true
        end
        if swap.oldPart then
            swap.oldPart.Transparency = 0
            swap.oldPart.CanCollide = true
        end
    end

    korbloxSwapData[side] = {}
    korbloxEnabled[side] = false

    if side == "Left" then
        leftLegButton.Text = "Left Leg"
    else
        rightLegButton.Text = "Right Leg"
    end

    print("[Korblox] Disabled " .. side .. " leg")
end

local function enableKorbloxLeg(side)
    local character = player.Character
    if not character then
        warn("[Korblox] No character found")
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        warn("[Korblox] No Humanoid found on character")
        return
    end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        warn("[Korblox] Your character is R6, not R15. Korblox leg replacements only work on R15 rigs.")
        return
    end

    local assetId = (side == "Left") and KORBLOX_LEFT_LEG_ID or KORBLOX_RIGHT_LEG_ID
    if assetId == 0 then
        warn("[Korblox] Asset ID not set for " .. side .. " leg.")
        return
    end

    print("[Korblox] Loading asset " .. assetId .. " for " .. side .. " leg...")

    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)

    if not success then
        warn("[Korblox] game:GetObjects threw an error: " .. tostring(result))
        return
    end

    if not result or #result == 0 then
        warn("[Korblox] game:GetObjects returned nothing for asset " .. assetId)
        return
    end

    local rootModel = result[1]

    -- The asset is a body-part replacement model containing MeshParts named
    -- e.g. "RightUpperLeg", "RightLowerLeg", "RightFoot" - NOT an Accessory.
    -- We clone each matching mesh part in, rebuild its Motor6D joint to
    -- connect to the character's rig, and hide the original limb part.
    local partNames = { side .. "UpperLeg", side .. "LowerLeg", side .. "Foot" }
    local replaced = {}
    local swaps = {}
    local anySuccess = false

    for _, partName in ipairs(partNames) do
        local newPart = nil
        if rootModel:IsA("BasePart") and rootModel.Name == partName then
            newPart = rootModel
        else
            newPart = rootModel:FindFirstChild(partName, true)
        end

        if not newPart or not newPart:IsA("BasePart") then
            warn("[Korblox] Asset did not contain a part named '" .. partName .. "'")
        else
            local oldPart = character:FindFirstChild(partName)
            if not oldPart or not oldPart:IsA("BasePart") then
                warn("[Korblox] Character has no part named '" .. partName .. "' (make sure you're R15)")
            else
                -- Find the Motor6D that attaches oldPart to its parent limb
                local motor = nil
                for _, child in ipairs(oldPart:GetChildren()) do
                    if child:IsA("Motor6D") and child.Part1 == oldPart then
                        motor = child
                        break
                    end
                end

                if not motor then
                    warn("[Korblox] Could not find a Motor6D joint for '" .. partName .. "'")
                else
                    local clonedPart = newPart:Clone()
                    clonedPart.CFrame = oldPart.CFrame
                    clonedPart.Parent = character

                    -- If the parent limb in this chain was already replaced
                    -- earlier in this loop, attach to the new one instead
                    -- of the original (now-hidden) part.
                    local part0 = motor.Part0
                    if part0 and replaced[part0.Name] then
                        part0 = replaced[part0.Name]
                    end

                    local newMotor = Instance.new("Motor6D")
                    newMotor.Name = motor.Name
                    newMotor.Part0 = part0
                    newMotor.Part1 = clonedPart
                    newMotor.C0 = motor.C0
                    newMotor.C1 = motor.C1
                    newMotor.Parent = clonedPart

                    motor.Enabled = false
                    oldPart.Transparency = 1
                    oldPart.CanCollide = false

                    replaced[partName] = clonedPart
                    table.insert(swaps, { oldPart = oldPart, motor = motor, clonedPart = clonedPart })
                    anySuccess = true
                    print("[Korblox] Swapped in " .. partName)
                end
            end
        end
    end

    if anySuccess then
        korbloxSwapData[side] = swaps
        korbloxEnabled[side] = true
        if side == "Left" then
            leftLegButton.Text = "Disable Left Leg"
        else
            rightLegButton.Text = "Disable Right Leg"
        end
    else
        warn("[Korblox] Nothing was swapped - see warnings above.")
    end
end

local function toggleKorbloxLeg(side)
    if korbloxEnabled[side] then
        disableKorbloxLeg(side)
    else
        enableKorbloxLeg(side)
    end
end

